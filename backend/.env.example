# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection. Port 5433 avoids clashing with a system PostgreSQL on 5432.
# Start one with `npm run db:local` (no Docker) or `docker compose up -d` (repo root).
DATABASE_URL="postgresql://aj:aj_dev_password@localhost:5433/aj_fleet?schema=public"
DIRECT_URL="postgresql://aj:aj_dev_password@localhost:5433/aj_fleet?schema=public"
# Separate database used by integration tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://aj:aj_dev_password@localhost:5433/aj_fleet_test?schema=public"

PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed by CORS (Expo web dev servers: driver 8081, admin 8082). Native apps do not need CORS.
CORS_ORIGINS="http://localhost:8081,http://localhost:8082"

# "local" (disk) or "vercel-blob" (private Vercel Blob store; required on Vercel).
PHOTO_STORAGE=local
# Directory for private meter photos. Must NOT be served statically.
PHOTO_STORAGE_DIR="./storage/photos"
# Max upload size in bytes (4 MB; Vercel rejects bodies over 4.5 MB).
PHOTO_MAX_BYTES=4194304

# Session lifetime in hours.
SESSION_TTL_HOURS=336

# Sign-in attempts allowed per client IP per minute.
LOGIN_ATTEMPTS_PER_MINUTE=10
